# ===== Copie para .env e preencha (NUNCA versione o .env) =====
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_PASSWORD=troque-esta-senha-do-app
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
APP_URL=http://localhost

# Pagamento: mercadopago (produção/sandbox) ou fake (somente desenvolvimento, com NODE_ENV=development)
PAYMENT_PROVIDER=fake
NODE_ENV=development
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Frete: flat (tabela de referência) ou melhorenvio
SHIPPING_PROVIDER=flat
MELHOR_ENVIO_TOKEN=

# E-mail: console (imprime no log) ou smtp
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

LOJA_EMAIL_CONTATO=contato@lumenlivraria.com.br
FRETE_GRATIS_ACIMA_CENTS=15000
SEED_ADMIN_EMAIL=admin@lumen.local
SEED_ADMIN_PASSWORD=
