# ===== Aplicação =====
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ===== Banco de dados (MySQL 8) =====
DATABASE_URL="mysql://lumen:lumen_dev_pwd@localhost:3306/lumen"

# ===== Segurança =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-esta-chave-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# ===== Loja =====
LOJA_CEP=12500000
LOJA_EMAIL_CONTATO=contato@lumenlivraria.com.br
PEDIDO_EXPIRA_MINUTOS=60
# Frete grátis (opção mais barata) a partir deste subtotal, em centavos. Vazio = desativado.
FRETE_GRATIS_ACIMA_CENTS=15000

# ===== Pagamento: fake (somente desenvolvimento) ou mercadopago =====
PAYMENT_PROVIDER=fake
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=

# ===== Frete: flat (tabela de referência) ou melhorenvio =====
SHIPPING_PROVIDER=flat
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br

# ===== E-mail: console (imprime no terminal) ou smtp =====
MAIL_TRANSPORT=console
MAIL_FROM="Lumen Livraria <nao-responda@lumenlivraria.com.br>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===== Uploads de imagens =====
UPLOAD_DIR=./uploads

# ===== Seed (opcional): senha do administrador inicial. Se vazio, é gerada e exibida no terminal =====
SEED_ADMIN_EMAIL=admin@lumen.local
SEED_ADMIN_PASSWORD=
